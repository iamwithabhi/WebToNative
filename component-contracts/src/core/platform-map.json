{
  "$schema": "./platform-map.schema.json",
  "$note": "Data for every web -> iOS / Android mapping. Logic lives in platform-map.js.",
  "accessibilityRoles": {
    "button": {
      "web": {
        "role": "button"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "Button"
      }
    },
    "link": {
      "web": {
        "role": "link"
      },
      "ios": {
        "traits": [
          "isLink"
        ]
      },
      "android": {
        "role": "Button"
      }
    },
    "checkbox": {
      "web": {
        "role": "checkbox"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "Checkbox"
      }
    },
    "radio": {
      "web": {
        "role": "radio"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "RadioButton"
      }
    },
    "switch": {
      "web": {
        "role": "switch"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "Switch"
      }
    },
    "tab": {
      "web": {
        "role": "tab"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "Tab"
      }
    },
    "menuitem": {
      "web": {
        "role": "menuitem"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "Button"
      }
    },
    "option": {
      "web": {
        "role": "option"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "Button"
      }
    },
    "textfield": {
      "web": {
        "role": "textbox"
      },
      "ios": {
        "plain": "TextField"
      },
      "android": {
        "plain": "TextField"
      }
    },
    "combobox": {
      "web": {
        "role": "combobox"
      },
      "ios": {
        "traits": [
          "isButton"
        ]
      },
      "android": {
        "role": "DropdownList"
      }
    },
    "search": {
      "web": {
        "role": "search"
      },
      "ios": {
        "traits": [
          "isSearchField"
        ]
      },
      "android": {
        "plain": "TextField"
      }
    },
    "slider": {
      "web": {
        "role": "slider"
      },
      "ios": {
        "traits": [
          "adjustable"
        ],
        "actions": [
          "increment",
          "decrement"
        ]
      },
      "android": {
        "progressSemantics": true
      }
    },
    "spinbutton": {
      "web": {
        "role": "spinbutton"
      },
      "ios": {
        "traits": [
          "adjustable"
        ],
        "actions": [
          "increment",
          "decrement"
        ]
      },
      "android": {
        "semantics": "stateDescription",
        "actions": [
          "increment",
          "decrement"
        ]
      }
    },
    "progressbar": {
      "web": {
        "role": "progressbar"
      },
      "ios": {
        "traits": [
          "updatesFrequently"
        ]
      },
      "android": {
        "progressSemantics": true
      }
    },
    "image": {
      "web": {
        "role": "img"
      },
      "ios": {
        "traits": [
          "isImage"
        ]
      },
      "android": {
        "role": "Image"
      }
    },
    "header": {
      "web": {
        "role": "heading"
      },
      "ios": {
        "traits": [
          "isHeader"
        ]
      },
      "android": {
        "heading": true
      }
    },
    "separator": {
      "web": {
        "role": "separator"
      },
      "ios": {
        "plain": "Divider"
      },
      "android": {
        "plain": "HorizontalDivider"
      }
    },
    "group": {
      "web": {
        "role": "group"
      },
      "ios": {
        "container": "contain"
      },
      "android": {
        "container": "mergeDescendants"
      }
    },
    "radiogroup": {
      "web": {
        "role": "radiogroup"
      },
      "ios": {
        "container": "contain"
      },
      "android": {
        "container": "selectableGroup"
      }
    },
    "tablist": {
      "web": {
        "role": "tablist"
      },
      "ios": {
        "container": "contain"
      },
      "android": {
        "container": "selectableGroup"
      }
    },
    "menu": {
      "web": {
        "role": "menu"
      },
      "ios": {
        "container": "contain"
      },
      "android": {
        "container": "mergeDescendants"
      }
    },
    "toolbar": {
      "web": {
        "role": "toolbar"
      },
      "ios": {
        "container": "contain"
      },
      "android": {
        "container": "mergeDescendants"
      }
    },
    "region": {
      "web": {
        "role": "region"
      },
      "ios": {
        "plain": "view"
      },
      "android": {
        "container": "mergeDescendants"
      }
    },
    "list": {
      "web": {
        "role": "list"
      },
      "ios": {
        "container": "contain"
      },
      "android": {
        "collection": true
      }
    },
    "listitem": {
      "web": {
        "role": "listitem"
      },
      "ios": {
        "plain": "List row"
      },
      "android": {
        "collectionItem": true
      }
    },
    "dialog": {
      "web": {
        "role": "dialog"
      },
      "ios": {
        "traits": [
          "isModal"
        ]
      },
      "android": {
        "container": "mergeDescendants"
      }
    },
    "alert": {
      "web": {
        "role": "alert"
      },
      "ios": {
        "liveRegion": "assertive"
      },
      "android": {
        "liveRegion": "assertive"
      }
    },
    "status": {
      "web": {
        "role": "status"
      },
      "ios": {
        "liveRegion": "polite"
      },
      "android": {
        "liveRegion": "polite"
      }
    },
    "tooltip": {
      "web": {
        "role": "tooltip"
      },
      "ios": {
        "plain": "help text"
      },
      "android": {
        "container": "mergeDescendants"
      }
    },
    "none": {
      "web": {
        "role": "presentation"
      },
      "ios": {
        "hidden": true
      },
      "android": {
        "hidden": true
      }
    }
  },
  "accessibilityStates": {
    "disabled": {
      "web": {
        "attribute": "aria-disabled"
      },
      "ios": {
        "trait": "notEnabled"
      },
      "android": {
        "semantics": "disabled()"
      }
    },
    "busy": {
      "web": {
        "attribute": "aria-busy",
        "live": "polite"
      },
      "ios": {
        "property": "accessibilityValue",
        "announce": "polite"
      },
      "android": {
        "semantics": "stateDescription"
      }
    },
    "expanded": {
      "web": {
        "attribute": "aria-expanded"
      },
      "ios": {
        "property": "accessibilityValue"
      },
      "android": {
        "semantics": "stateDescription"
      }
    },
    "selected": {
      "web": {
        "attribute": "aria-selected"
      },
      "ios": {
        "trait": "isSelected"
      },
      "android": {
        "semantics": "selected"
      }
    },
    "checked": {
      "web": {
        "attribute": "aria-checked"
      },
      "ios": {
        "trait": "isSelected"
      },
      "android": {
        "semantics": "toggleableState"
      }
    },
    "readonly": {
      "web": {
        "attribute": "aria-readonly"
      },
      "ios": {
        "property": "accessibilityValue"
      },
      "android": {
        "semantics": "stateDescription"
      }
    }
  },
  "touchTargets": {
    "floor": {
      "web": 44,
      "ios": 44,
      "android": 48
    },
    "unit": {
      "web": "px",
      "ios": "pt",
      "android": "dp"
    }
  },
  "animatableProperties": {
    "opacity": {
      "web": "opacity",
      "ios": "opacity",
      "android": "alpha"
    },
    "transform": {
      "web": "transform",
      "ios": "transformEffect",
      "android": "graphicsLayer"
    },
    "scale": {
      "web": "transform: scale",
      "ios": "scaleEffect",
      "android": "graphicsLayer.scale"
    },
    "translateX": {
      "web": "transform: translateX",
      "ios": "offset.x",
      "android": "graphicsLayer.translationX"
    },
    "translateY": {
      "web": "transform: translateY",
      "ios": "offset.y",
      "android": "graphicsLayer.translationY"
    },
    "rotation": {
      "web": "transform: rotate",
      "ios": "rotationEffect",
      "android": "graphicsLayer.rotationZ"
    },
    "fill": {
      "web": "background-color",
      "ios": "background",
      "android": "containerColor"
    },
    "labelColor": {
      "web": "color",
      "ios": "foregroundColor",
      "android": "contentColor"
    },
    "borderColor": {
      "web": "border-color",
      "ios": "border",
      "android": "borderColor"
    }
  },
  "refusedForMotion": {
    "blur": "GPU cost and visual result differ substantially per platform",
    "boxShadow": "Not animatable on Android without overdraw; use elevation instead",
    "width": "Layout-driven; triggers reflow and behaves differently per platform",
    "height": "Layout-driven; triggers reflow and behaves differently per platform",
    "shadow": "Use elevation intent instead of animating shadow directly"
  },
  "pointerOnlyStates": [
    "hover"
  ],
  "mechanismPlatforms": {
    "ripple": [
      "android"
    ],
    "highlight": [
      "ios",
      "web"
    ],
    "scale": [
      "web",
      "ios",
      "android"
    ],
    "opacity": [
      "web",
      "ios",
      "android"
    ],
    "tint": [
      "ios"
    ],
    "elevation": [
      "android"
    ]
  },
  "cssKeywords": [
    "transparent",
    "none",
    "currentcolor",
    "inherit",
    "initial",
    "unset"
  ],
  "namedCurves": {
    "linear": [
      0,
      0,
      1,
      1
    ],
    "ease": [
      0.25,
      0.1,
      0.25,
      1
    ],
    "easeIn": [
      0.42,
      0,
      1,
      1
    ],
    "easeOut": [
      0,
      0,
      0.58,
      1
    ],
    "easeInOut": [
      0.42,
      0,
      0.58,
      1
    ],
    "standard": [
      0.4,
      0,
      0.2,
      1
    ],
    "decelerate": [
      0,
      0,
      0.2,
      1
    ],
    "accelerate": [
      0.4,
      0,
      1,
      1
    ]
  },
  "curveApi": {
    "ios": {
      "key": "timingCurve",
      "call": "Animation.timingCurve(c0x, c0y, c1x, c1y)"
    },
    "android": {
      "key": "cubicBezierEasing",
      "call": "CubicBezierEasing(c0x, c0y, c1x, c1y)"
    },
    "web": {
      "key": "cssEasing",
      "call": "cubic-bezier(...)"
    }
  },
  "springApi": {
    "ios": {
      "call": ".spring(response:dampingFraction:)",
      "params": [
        "response",
        "dampingFraction"
      ],
      "exact": ".interpolatingSpring(mass:stiffness:damping:)"
    },
    "android": {
      "call": "spring(dampingRatio, stiffness)",
      "params": [
        "dampingRatio",
        "stiffness"
      ],
      "note": "Assumes unit mass; stiffness is normalised by mass."
    },
    "web": {
      "call": "spring({ stiffness, damping, mass })",
      "params": [
        "stiffness",
        "damping",
        "mass"
      ],
      "note": "Takes the canonical form directly."
    }
  },
  "source": {
    "cssPropertyRole": {
      "background-color": "fill",
      "background": "fill",
      "color": "labelColor",
      "border-color": "borderColor",
      "border-width": "borderWidth",
      "border-radius": "radius",
      "font-size": "fontSize",
      "font-weight": "fontWeight",
      "line-height": "lineHeight",
      "letter-spacing": "letterSpacing",
      "gap": "gap",
      "opacity": "opacity"
    },
    "visualProperties": {
      "border-style": "borderStyle",
      "border-radius": "radius",
      "width": "width",
      "height": "height",
      "min-width": "minWidth",
      "min-height": "minHeight",
      "max-width": "maxWidth",
      "max-height": "maxHeight",
      "display": "display",
      "box-sizing": "boxSizing",
      "align-items": "alignItems",
      "align-self": "alignSelf",
      "justify-content": "justifyContent",
      "flex-direction": "flexDirection",
      "flex-grow": "flexGrow",
      "flex-shrink": "flexShrink",
      "flex-basis": "flexBasis",
      "position": "position",
      "top": "top",
      "left": "left",
      "content": "content",
      "transform": "transform",
      "outline-offset": "outlineOffset",
      "font-family": "fontFamily",
      "font-variant-numeric": "fontVariantNumeric",
      "border-top-width": "borderTopWidth",
      "border-right-width": "borderRightWidth",
      "border-bottom-width": "borderBottomWidth",
      "border-left-width": "borderLeftWidth",
      "border-top-color": "borderTopColor",
      "border-right-color": "borderRightColor",
      "border-bottom-color": "borderBottomColor",
      "border-left-color": "borderLeftColor",
      "overflow": "overflow",
      "text-align": "textAlign",
      "text-decoration": "textDecoration",
      "text-overflow": "textOverflow",
      "white-space": "whiteSpace",
      "aspect-ratio": "aspectRatio"
    },
    "pseudoState": {
      ":hover": "hover",
      ":active": "pressed",
      ":focus-visible": "focused",
      ":focus": "focused",
      ":disabled": "disabled",
      "[aria-busy='true']": "loading",
      "[aria-busy=\"true\"]": "loading",
      "[data-loading]": "loading"
    },
    "utilityRoles": {
      "bg": "fill",
      "text": "labelColor",
      "border": "borderColor",
      "ring": "focusRing",
      "fill": "fill",
      "px": "padX",
      "py": "padY",
      "p": "pad",
      "gap": "gap",
      "rounded": "radius",
      "font": "fontWeight",
      "leading": "lineHeight"
    },
    "nativeActivation": {
      "Button": {
        "event": "onClick",
        "payload": "none"
      },
      "Anchor": {
        "event": "onClick",
        "payload": "none"
      },
      "Input": {
        "event": "onChange",
        "payload": "value"
      },
      "Select": {
        "event": "onChange",
        "payload": "value"
      },
      "TextArea": {
        "event": "onChange",
        "payload": "value"
      },
      "Form": {
        "event": "onSubmit",
        "payload": "none"
      }
    },
    "webOnlyProperties": {
      "cursor": "Pointer cursor; touch platforms have no cursor.",
      "user-select": "Text selection; not applied to a control on iOS or Android.",
      "-webkit-user-select": "Vendor prefix of user-select.",
      "-webkit-tap-highlight-color": "Browser tap flash; native controls draw their own pressed feedback.",
      "touch-action": "Browser gesture filtering; native gesture handling is separate."
    }
  },
  "roleExpression": {
    "$note": "Check each field in order; the first one present decides the text. {value} is the field value; {item} is one entry of a list.",
    "order": [
      "plain",
      "hidden",
      "traits",
      "role",
      "container",
      "semantics",
      "progressSemantics",
      "liveRegion",
      "heading",
      "collection",
      "collectionItem"
    ],
    "forms": {
      "plain": {
        "template": "{value}",
        "flag": "plain"
      },
      "hidden": {
        "template": "accessibilityHidden",
        "flag": "hidden"
      },
      "traits": {
        "template": ".{item}",
        "join": ", "
      },
      "role": {
        "template": "Role.{value}"
      },
      "container": {
        "template": "container({value})"
      },
      "semantics": {
        "template": "{value}"
      },
      "progressSemantics": {
        "template": "progressSemantics"
      },
      "liveRegion": {
        "template": "liveRegion({value})"
      },
      "heading": {
        "template": "heading"
      },
      "collection": {
        "template": "collection"
      },
      "collectionItem": {
        "template": "collectionItem"
      }
    },
    "unmapped": {
      "text": null,
      "unmapped": true
    }
  },
  "tokenTypeByRole": {
    "fill": "color",
    "labelColor": "color",
    "borderColor": "color",
    "focusRing": "color",
    "fontWeight": "fontWeight",
    "fontFamily": "fontFamily"
  },
  "tokenTypeDefault": "dimension",
  "semantics": {
    "$note": "CSS roles read from the component, restated as platform-neutral layout concepts. A role mapped to null is consumed elsewhere (see consumedBy) or has no native effect (see reason); it is listed rather than silently dropped.",
    "fields": {
      "display": {
        "to": "container.kind",
        "values": "display"
      },
      "flexDirection": {
        "to": "container.axis",
        "values": "axis"
      },
      "alignItems": {
        "to": "container.crossAlign",
        "values": "alignment"
      },
      "justifyContent": {
        "to": "container.mainAlign",
        "values": "alignment"
      },
      "gap": {
        "to": "container.gap"
      },
      "alignSelf": {
        "to": "item.selfAlign",
        "values": "alignment"
      },
      "flexGrow": {
        "to": "item.grow"
      },
      "flexShrink": {
        "to": "item.shrink"
      },
      "flexBasis": {
        "to": "item.basis"
      },
      "width": {
        "to": "size.width"
      },
      "height": {
        "to": "size.height"
      },
      "minWidth": {
        "to": "size.minWidth"
      },
      "minHeight": {
        "to": "size.minHeight"
      },
      "maxWidth": {
        "to": "size.maxWidth"
      },
      "maxHeight": {
        "to": "size.maxHeight"
      },
      "aspectRatio": {
        "to": "size.aspectRatio"
      },
      "boxSizing": {
        "to": "size.includesBorderAndPadding",
        "values": "boxSizing"
      },
      "padTop": {
        "to": "padding.top"
      },
      "padRight": {
        "to": "padding.right"
      },
      "padBottom": {
        "to": "padding.bottom"
      },
      "padLeft": {
        "to": "padding.left"
      },
      "borderWidth": {
        "to": "border.width"
      },
      "borderStyle": {
        "to": "border.style"
      },
      "borderColor": {
        "to": "border.color"
      },
      "borderTopWidth": {
        "to": "border.top.width"
      },
      "borderRightWidth": {
        "to": "border.right.width"
      },
      "borderBottomWidth": {
        "to": "border.bottom.width"
      },
      "borderLeftWidth": {
        "to": "border.left.width"
      },
      "borderTopColor": {
        "to": "border.top.color"
      },
      "borderRightColor": {
        "to": "border.right.color"
      },
      "borderBottomColor": {
        "to": "border.bottom.color"
      },
      "borderLeftColor": {
        "to": "border.left.color"
      },
      "radius": {
        "to": "cornerRadius"
      },
      "fill": {
        "to": "background"
      },
      "opacity": {
        "to": "opacity"
      },
      "overflow": {
        "to": "clip",
        "values": "overflow"
      },
      "labelColor": {
        "to": "foreground",
        "inherited": true
      },
      "typography": {
        "to": "typography",
        "inherited": true
      },
      "fontFamily": {
        "to": "text.family",
        "inherited": true
      },
      "fontSize": {
        "to": "text.size",
        "inherited": true
      },
      "fontWeight": {
        "to": "text.weight",
        "inherited": true
      },
      "lineHeight": {
        "to": "text.lineHeight",
        "inherited": true
      },
      "letterSpacing": {
        "to": "text.letterSpacing",
        "inherited": true
      },
      "fontVariantNumeric": {
        "to": "text.numericFigures",
        "values": "numericFigures",
        "inherited": true
      },
      "textAlign": {
        "to": "text.align",
        "values": "textAlign",
        "inherited": true
      },
      "whiteSpace": {
        "to": "text.wrap",
        "values": "whiteSpace",
        "inherited": true
      },
      "textOverflow": {
        "to": "text.overflow",
        "values": "textOverflow"
      },
      "textDecoration": {
        "to": "text.decoration"
      },
      "transform": {
        "to": "transform"
      },
      "position": {
        "to": null,
        "values": "position",
        "reason": "relative only anchors absolutely positioned descendants; it has no effect on native layout"
      },
      "top": {
        "to": null,
        "consumedBy": "hitAreas"
      },
      "left": {
        "to": null,
        "consumedBy": "hitAreas"
      },
      "content": {
        "to": null,
        "consumedBy": "hitAreas"
      },
      "outlineStyle": {
        "to": null,
        "consumedBy": "focusRings"
      },
      "outlineWidth": {
        "to": null,
        "consumedBy": "focusRings"
      },
      "outlineColor": {
        "to": null,
        "consumedBy": "focusRings"
      },
      "outlineOffset": {
        "to": null,
        "consumedBy": "focusRings"
      },
      "transitionEnabled": {
        "to": null,
        "consumedBy": "animations"
      },
      "transitionDurationMs": {
        "to": null,
        "consumedBy": "animations"
      },
      "animation": {
        "to": null,
        "consumedBy": "animations"
      },
      "animationDurationMs": {
        "to": null,
        "consumedBy": "animations"
      }
    },
    "values": {
      "display": {
        "flex": "stack",
        "inline-flex": "stack",
        "block": null
      },
      "axis": {
        "row": "horizontal",
        "column": "vertical"
      },
      "alignment": {
        "center": "center",
        "flex-start": "start",
        "start": "start",
        "flex-end": "end",
        "end": "end",
        "stretch": "stretch",
        "baseline": "baseline",
