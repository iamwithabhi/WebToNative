  "logic": [
    {
      "name": "clamp",
      "kind": "function",
      "scope": "module",
      "source": "const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));",
      "uses": []
    },
    {
      "name": "isControlled",
      "kind": "value",
      "scope": "component",
      "source": "const isControlled = controlledValue !== undefined;",
      "uses": []
    },
    {
      "name": "value",
      "kind": "value",
      "scope": "component",
      "source": "const value = clamp(isControlled ? controlledValue : uncontrolled, min, max);",
      "uses": [
        "clamp",
        "isControlled"
      ]
    },
    {
      "name": "stopHold",
      "kind": "function",
      "scope": "component",
      "source": "const stopHold = useCallback(() => {\n    clearInterval(holdTimer.current);\n    holdTimer.current = undefined;\n  }, []);",
      "uses": []
    },
    {
      "name": "useEffect#1",
      "kind": "effect",
      "scope": "component",
      "source": "useEffect(() => {\n    if (frozen) return;\n    window.addEventListener('pointerup', stopHold);\n    window.addEventListener('pointercancel', stopHold);\n    return () => {\n      window.removeEventListener('pointerup', stopHold);\n      window.removeEventListener('pointercancel', stopHold);\n    };\n  }, [frozen, stopHold]);",
      "uses": [
        "stopHold"
      ]
    },
    {
      "name": "setValue",
