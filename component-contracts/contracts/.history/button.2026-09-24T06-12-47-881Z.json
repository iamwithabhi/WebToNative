  "layout": {
    "childOrder": [
      "iconStart",
      "iconEnd",
      "label",
      "spinner",
      "icon"
    ],
    "display": "inline-flex",
    "align": "center",
    "justify": "center",
    "direction": "horizontal"
  },
  "composition": {
    "children": {
      "iconStart": {
        "contentType": "icon",
        "boundTo": "prop:iconStart",
        "required": false,
        "hiddenIn": [
          "loading"
        ]
      },
      "iconEnd": {
        "contentType": "icon",
        "boundTo": "prop:iconEnd",
        "required": false,
        "hiddenIn": [
          "loading"
        ]
      },
      "label": {
        "contentType": "text",
        "boundTo": "prop:label",
        "required": true
      },
      "spinner": {
        "contentType": "indicator",
        "required": false,
        "visibleIn": [
          "loading"
        ]
      },
      "icon": {
        "contentType": "icon",
        "required": false,
        "hiddenIn": [
          "loading"
        ]
      }
    }
  },
  "behavior": {
    "initial": null,
    "guards": {},
    "states": {}
  },
  "motion": {
    "transitions": [
      {
        "on": "*->*",
        "properties": [
          "fill"
        ],
        "duration": 120,
        "curve": {
          "type": "ease"
        },
        "interruptible": true,
        "reducedMotion": "instant"
      },
      {
        "on": "*->*",
        "properties": [
          "borderColor"
        ],
        "duration": 120,
        "curve": {
          "type": "ease"
        },
        "interruptible": true,
        "reducedMotion": "instant"
      },
      {
        "on": "*->*",
        "properties": [
          "labelColor"
        ],
        "duration": 120,
        "curve": {
          "type": "ease"
        },
        "interruptible": true,
        "reducedMotion": "instant"
      }
    ],
    "loops": [
      {
        "id": "ds-button-spin",
        "activeIn": [
          "loading"
        ],
        "property": "rotation",
        "from": 0,
        "to": 360,
        "duration": 700,
        "curve": {
          "type": "linear"
        },
        "iterations": "infinite",
        "reducedMotion": "fade"
      }
    ]
  },
  "a11y": {
    "role": "button",
    "state": {
      "busy": true,
      "disabled": true
    },
    "label": {
      "source": "prop:label",
      "required": true
    },
    "minTargetSize": "{semantic.size.48}",
    "focus": {
      "indicator": "focusRing"
    },
    "keyboard": []
  },
  "adaptable": {}
